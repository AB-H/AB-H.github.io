```{=html}
<% const order = ['Books', 'The Conversation', 'Images des mathématiques', 'Blogs', 'Press'];
   for (const sec of order) {
     const group = items.filter((it) => (it.categories || [])[0] === sec);
     if (!group.length) continue; %>
<h2 class="pub-year"><%= sec %> <span class="viz-muted">(<%= group.length %>)</span></h2>
<div class="list">
<% for (const item of group) { %>
<div class="pub" <%= metadataAttrs(item) %>>
  <div class="pub-title"><span class="pub-yr"><%= item.year %></span> <% if (item.url) { %><a href="<%= item.url %>" class="outreach-link"><%= item.title %></a><% } else { %><%= item.title %><% } %></div>
  <% if (item.authors) { %><div class="pub-authors"><% String(item.authors).split(', ').forEach((n, i) => { %><%= i ? ', ' : '' %><% if (n === 'A. Bar-Hen') { %><strong>A. Bar-Hen</strong><% } else { %><%= n %><% } %><% }) %></div><% } %>
  <% if (item.venue || item.date) { %><div class="pub-venue"><%= item.venue || item.date %></div><% } %>
  <% if (item.alt_url) { %><div class="pub-links"><a href="<%= item.alt_url %>">English version</a></div><% } %>
</div>
<% } %>
</div>
<% } %>
```
